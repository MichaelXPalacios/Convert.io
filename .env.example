# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
# Nothing in this repo reads a credential from anywhere but the environment.

# --- Postgres (Neon) -------------------------------------------------------
# Pooled connection for the application. Used by the edge runtime.
DATABASE_URL=

# Direct connection. Migrations and long transactions use this one, because
# DDL through a transaction pooler is unreliable.
DATABASE_URL_UNPOOLED=

# Which Neon branch this environment is pointed at. Informational.
NEON_BRANCH=

# --- Redis (Upstash in production, local redis in development) --------------
# The posterior mirror. The edge reads this once on the hot path.
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anthropic -------------------------------------------------------------
# Audit engine and variant generation.
ANTHROPIC_API_KEY=

# --- Conversion webhooks ---------------------------------------------------
# Signature verification. A webhook with an unverifiable signature is rejected,
# so an unset secret disables that provider rather than trusting it.
SHOPIFY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Meta Conversions API --------------------------------------------------
# Optional. When the token is unset the forwarder no-ops cleanly.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# --- Admin ----------------------------------------------------------------
# Comma separated email allowlist for the admin surface.
ADMIN_ALLOWED_EMAILS=

# --- Cron ------------------------------------------------------------------
# Shared secret Vercel Cron presents when invoking the worker route.
CRON_SECRET=
