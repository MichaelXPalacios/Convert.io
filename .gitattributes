# Line endings are LF in the repository and LF in the working tree, on every
# platform. Without this, core.autocrlf on Windows checks files out as CRLF
# while prettier writes LF, so `prettier --check .` fails on a fresh clone
# against files nobody has touched — a formatting gate that looks broken when
# the formatting is fine.
* text=auto eol=lf

# Binary files must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip  binary
*.exe  binary
